---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StartGame from '@/components/StartGame';
import LeaderboardTable from '@/components/LeaderboardTable.astro';
import { getCurrentUser } from '@/lib/auth/session';
import { getLeaderboard } from '@/lib/game/service';
import type { CurrentUser } from '@/lib/auth/session';
import type { LeaderboardRow } from '@/lib/game/service';

let currentUser: CurrentUser | null = null;
let leaderboard: LeaderboardRow[] = [];
let setupError = '';

try {
  currentUser = await getCurrentUser(Astro.cookies).catch(() => null);
  leaderboard = await getLeaderboard(8);
} catch (error) {
  setupError = error instanceof Error ? error.message : 'No se pudo conectar con la base de datos.';
}
---

<BaseLayout title="WikiRace">
  <section class="bg-[#f7f5ef]">
    <div class="mx-auto grid min-h-[calc(100vh-65px)] max-w-6xl gap-10 px-4 py-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-sky-800">Modo clásico</p>
        <h1 class="max-w-3xl text-5xl font-black leading-[0.98] tracking-tight text-stone-950 md:text-7xl">
          Llega al artículo objetivo usando solo enlaces.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-700">
          Elige un origen y una meta en Wikipedia. Gana quien complete la ruta con menos clicks y menor tiempo.
        </p>
        <div class="mt-8 grid max-w-xl grid-cols-3 gap-3 text-sm">
          <div class="rounded-lg border border-stone-200 bg-white p-4">
            <strong class="block text-2xl text-stone-950">2</strong>
            idiomas iniciales
          </div>
          <div class="rounded-lg border border-stone-200 bg-white p-4">
            <strong class="block text-2xl text-stone-950">0</strong>
            atajos externos
          </div>
          <div class="rounded-lg border border-stone-200 bg-white p-4">
            <strong class="block text-2xl text-stone-950">100%</strong>
            validado server-side
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
        {setupError ? (
          <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
            <strong class="block">Base de datos pendiente</strong>
            Configura <code>DATABASE_URL</code> y ejecuta la migración inicial para crear partidas. Detalle: {setupError}
          </div>
        ) : null}
        <StartGame client:load currentUser={currentUser} disabled={Boolean(setupError)} />
      </div>
    </div>
  </section>

  <section class="border-t border-stone-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-sky-800">Ranking</p>
          <h2 class="mt-2 text-3xl font-black text-stone-950">Mejores carreras recientes</h2>
        </div>
        <a href="/leaderboard" class="text-sm font-bold text-sky-800 underline underline-offset-4">Ver todo</a>
      </div>
      <LeaderboardTable rows={leaderboard} />
    </div>
  </section>
</BaseLayout>
