---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Entrar - WikiRace">
  <section class="mx-auto grid min-h-[calc(100vh-65px)] max-w-md place-items-center px-4 py-12">
    <form class="w-full rounded-lg border border-stone-200 bg-white p-6 shadow-sm" method="post" action="/api/auth/login">
      <h1 class="text-3xl font-black text-stone-950">Entrar</h1>
      <p class="mt-2 text-sm text-stone-600">Guarda tu historial y juega con identidad persistente.</p>

      <label class="mt-6 block text-sm font-bold text-stone-800">
        Email
        <input class="mt-2 w-full rounded-md border border-stone-300 px-3 py-2" type="email" name="email" required />
      </label>

      <label class="mt-4 block text-sm font-bold text-stone-800">
        Contraseña
        <input class="mt-2 w-full rounded-md border border-stone-300 px-3 py-2" type="password" name="password" required />
      </label>

      <button class="mt-6 w-full rounded-md bg-sky-800 px-4 py-3 font-black text-white">Entrar</button>
      <p class="mt-4 text-center text-sm text-stone-600">
        ¿No tienes cuenta? <a class="font-bold text-sky-800 underline underline-offset-4" href="/register">Crear cuenta</a>
      </p>
    </form>
  </section>
</BaseLayout>
